const grid=document.getElementById('grid'), search=document.getElementById('search'), count=document.getElementById('count');
let active='All';
function esc(s=''){return String(s).replace(/[&<>\"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c]))}
function kind(p){const n=p.name.toLowerCase();
  if(/microphone|sm58/.test(n)) return 'mic'; if(/presenter|cue|commander|remote/.test(n)) return 'remote'; if(/mixer|atem|stream deck|switcher/.test(n)) return 'console'; if(/cam link|camera|doorbell/.test(n)) return 'camera'; if(/hdmi|usb-c|hub|cable|power strip/.test(n)) return 'cable'; if(/direct box|prodi/.test(n)) return 'box'; if(/kong|ball|toy|digger/.test(n)) return 'toy'; if(/harness|seat belt/.test(n)) return 'harness'; if(/litter|poop bags|dental|greenies/.test(n)) return 'petcare'; if(/furminator|roller|carpet cleaner|mop/.test(n)) return 'clean'; if(/bowls|feeder/.test(n)) return 'bowl'; if(/drill|screwdriver|tool set|multimeter|tape measure/.test(n)) return 'tool'; if(/battery|power bank/.test(n)) return 'battery'; if(/instant pot/.test(n)) return 'pot'; if(/command large/.test(n)) return 'frame'; return 'box';}
