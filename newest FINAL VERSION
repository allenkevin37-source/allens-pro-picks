 return shapes[k]||shapes.box;}
function render(){
 const q=search.value.trim().toLowerCase(); const items=window.ALLENS_PRODUCTS.filter(p=>(active==='All'||p.category===active)&&(!q||[p.name,p.category,p.note,p.why].join(' ').toLowerCase().includes(q)));
 count.textContent=`Showing ${items.length} pick${items.length===1?'':'s'}`;
 grid.innerHTML=items.map(p=>{const exact=/amazon\.com\/dp\//.test(p.url);return `<article class="card"><div class="visual ${kind(p)}">${svg(p)}<small>representative illustration</small></div><div class="card-body"><div><span class="tag">${esc(p.category)}</span>${p.badge?`<span class="badge">${esc(p.badge)}</span>`:''}</div><h3>${esc(p.name)}</h3><p>${esc(p.note)}</p><p class="why"><strong>Why it made the list:</strong> ${esc(p.why)}</p><p class="price-note">${exact?'Exact product page':'Amazon results for this exact product name'} — current photos, price and availability shown on Amazon.</p><p class="paid">Paid affiliate link</p><a class="button small" href="${p.url}" target="_blank" rel="nofollow sponsored noopener">${exact?'View current price & photos':'Find this product on Amazon'}</a></div></article>`}).join('');}
document.querySelectorAll('.filter').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.filter').forEach(x=>x.classList.remove('active'));b.classList.add('active');active=b.dataset.cat;render();}));search.addEventListener('input',render);
const cat=new URLSearchParams(location.search).get('cat'); if(cat&&[...document.querySelectorAll('.filter')].some(b=>b.dataset.cat===cat)){active=cat;document.querySelectorAll('.filter').forEach(b=>b.classList.toggle('active',b.dataset.cat===cat));}
render();
